root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

# The prevailing styles (docs/CODING_STANDARDS.md); CMake and Markdown are mixed and shell scripts embed
# space-indented Python, so editors keep their own choice.
[*.{cpp,h,mm}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{json,yaml,yml}]
indent_style = space
indent_size = 2
