{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "27.0",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VEKT_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Development",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VEKT_WARNINGS_AS_ERRORS": "ON",
        "CMAKE_OSX_SYSROOT": "macosx"
      }
    },
    {
      "name": "dev-opt",
      "displayName": "Development, optimised tests",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VEKT_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VEKT_BUILD_TESTS": "OFF",
        "VEKT_USE_CCACHE": "OFF"
      }
    },
    {
      "name": "audio-lab",
      "displayName": "Audio Lab",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VEKT_BUILD_TESTS": "OFF",
        "VEKT_BUILD_AUDIO_LAB": "ON",
        "VEKT_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "audio-lab-release",
      "displayName": "Audio Lab Release",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VEKT_BUILD_TESTS": "OFF",
        "VEKT_BUILD_AUDIO_LAB": "ON"
      }
    },
    {
      "name": "xcode",
      "displayName": "Xcode",
      "inherits": "base",
      "generator": "Xcode"
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "dev-opt",
      "configurePreset": "dev-opt"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "audio-lab",
      "configurePreset": "audio-lab"
    },
    {
      "name": "audio-lab-release",
      "configurePreset": "audio-lab-release"
    },
    {
      "name": "xcode-debug",
      "configurePreset": "xcode",
      "configuration": "Debug"
    },
    {
      "name": "xcode-release",
      "configurePreset": "xcode",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 10
      }
    },
    {
      "name": "dev-quick",
      "inherits": "dev",
      "filter": {
        "exclude": {
          "label": "^slow$"
        }
      }
    },
    {
      "name": "dev-opt",
      "configurePreset": "dev-opt",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 10
      },
      "filter": {
        "exclude": {
          "name": "reference render still sounds the same"
        }
      }
    },
    {
      "name": "dev-opt-quick",
      "inherits": "dev-opt",
      "filter": {
        "exclude": {
          "label": "^slow$",
          "name": "reference render still sounds the same"
        }
      }
    }
  ]
}
